import Foundation

// Copy this file to Secrets.swift (same folder) and fill in the real values
// - Secrets.swift is gitignored so it never gets committed. This file (the
// .example) is excluded from the build target in project.yml, so leaving
// both around after copying is fine; only Secrets.swift gets compiled.
enum Secrets {
    // Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
    // Find it in the Supabase dashboard under Project Settings > API.
    static let supabaseURL = URL(string: "https://YOUR-PROJECT-REF.supabase.co")!

    // The "anon" / "public" key from the same page - safe to embed in a
    // client app (RLS is what actually protects data, same assumption the
    // web app's own NEXT_PUBLIC_SUPABASE_ANON_KEY makes). Never the
    // service-role key.
    static let supabaseAnonKey = "YOUR-SUPABASE-ANON-KEY"

    // The running-dashboard deployment's base URL (no trailing slash), e.g.
    // https://stayinthefight.vercel.app - this is where CoreTempAPI posts
    // sessions/readings.
    static let apiBaseURL = URL(string: "https://YOUR-DEPLOYMENT.vercel.app")!
}
